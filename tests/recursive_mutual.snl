program recmutual
var
  integer n, oddflag;

procedure odd(integer x; var integer outv);
begin
  if x = 0 then
    outv := 0
  else
    even(x - 1, outv)
  fi
end

procedure even(integer x; var integer outv);
begin
  if x = 0 then
    outv := 1
  else
    odd(x - 1, outv)
  fi
end

begin
  n := 7;
  odd(n, oddflag);
  write(oddflag)
end.
